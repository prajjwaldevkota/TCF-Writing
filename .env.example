# Supabase Configuration
# Replace with your project URL and public anon/publishable key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini API Configuration
# Get a free API key from https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_MODEL=gemini-3.1-flash-lite

# Groq API Configuration (Optional: provides blazing-fast second AI evaluation)
# Get a free API key from https://console.groq.com/keys
VITE_GROQ_API_KEY=your-groq-api-key
VITE_GROQ_MODEL=openai/gpt-oss-120b
