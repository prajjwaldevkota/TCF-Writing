# Supabase Configuration
# Replace with your project URL and public anon/publishable key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini API Configuration
# Get a free API key from https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key
# Optional; defaults to gemini-3.8-flash automatically
GEMINI_MODEL=gemini-3.8-flash

# Optional Gemini backup key (same-project keys share quota)
GEMINI_BACKUP_KEY=
# GEMINI_BACKUP_KEY is server-only and is used by the Vercel /api/gemini function.
