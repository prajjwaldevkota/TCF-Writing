# Supabase Configuration
# Replace with your project URL and public anon/publishable key from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini API Configuration (server-only, also set in your Vercel environment)
# Get a free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional; defaults to gemini-4-hydrogen automatically
GEMINI_MODEL=gemini-4-hydrogen

# Optional Gemini backup key (same-project keys share quota)
GEMINI_BACKUP_KEY=
# Both keys are read by /api/gemini; users do not enter keys in their browser.

# Error logging (Vercel server only; never prefix the service-role key with VITE_)
# SUPABASE_URL may be omitted when VITE_SUPABASE_URL is already set.
SUPABASE_SERVICE_ROLE_KEY=

# Optional durable background reviews. Apply supabase/evaluation-jobs.sql first.
# Enable only after QStash and the public worker URL are ready.
EVALUATION_QUEUE_ENABLED=false
QSTASH_TOKEN=
# Generate a random secret of at least 32 characters; never VITE-prefix it.
EVALUATION_WORKER_SECRET=
# Your canonical HTTPS site origin, without a path (not a browser-supplied URL).
EVALUATION_PUBLIC_URL=https://your-project.vercel.app
